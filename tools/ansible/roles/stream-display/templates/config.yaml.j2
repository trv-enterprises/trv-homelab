# /etc/stream-display/config.yaml -- rendered by Ansible (stream-display role).
# Do not edit by hand; edits are overwritten on the next deploy. Source:
# trv-homelab/tools/ansible/roles/stream-display/templates/config.yaml.j2,
# values from homelab-deploy/inventory/host_vars/{{ inventory_hostname }}.yml.

display:
  name: {{ stream_display_name }}
  start_url: "{{ stream_display_start_url }}"
  screen: { width: {{ stream_display_screen_width }}, height: {{ stream_display_screen_height }} }
  device_scale: {{ stream_display_device_scale }}
  max_fps: {{ stream_display_max_fps }}
  jpeg_quality: {{ stream_display_jpeg_quality }}
  http_port: {{ stream_display_http_port }}
  idle_grace_s: {{ stream_display_idle_grace_s }}
  alive_ttl_s: {{ stream_display_alive_ttl_s }}
  keepalive_s: {{ stream_display_keepalive_s }}
  vaapi_device: "{{ stream_display_vaapi_device }}"
mqtt:
  broker: {{ stream_display_mqtt_broker }}
  port: {{ stream_display_mqtt_port }}
  topic_prefix: "display/{{ stream_display_name }}"
  dashboard_command_topic: "{{ stream_display_dashboard_command_topic }}"
  dashboard_client_id: "{{ stream_display_dashboard_client_id }}"
logging:
  level: {{ stream_display_log_level }}
