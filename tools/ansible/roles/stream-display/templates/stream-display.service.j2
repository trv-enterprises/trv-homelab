[Unit]
Description=stream-display: dashboard as change-driven MJPEG, MQTT-controlled
After=network-online.target stream-xvfb.service
Requires=stream-xvfb.service

[Service]
Type=simple
User={{ stream_display_user }}
WorkingDirectory={{ stream_display_deploy_dir }}
Environment=DISPLAY=:99
Environment=PLAYWRIGHT_BROWSERS_PATH={{ stream_display_browsers_path }}
ExecStart={{ stream_display_deploy_dir }}/venv/bin/python {{ stream_display_deploy_dir }}/stream_display.py --config /etc/stream-display/config.yaml
# The browser can take a few seconds to exit; don't let systemd wait forever.
TimeoutStopSec=15
KillMode=mixed
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
