[Unit]
Description=stream-display %i: dashboard as change-driven MJPEG, MQTT-controlled
After=network-online.target stream-xvfb@%i.service
Requires=stream-xvfb@%i.service

[Service]
Type=simple
User={{ stream_display_user }}
WorkingDirectory={{ stream_display_deploy_dir }}
# DISPLAY (and XNUM/XGEOM) come from the EnvironmentFile; systemd does not
# expand ${XNUM} inside an Environment= line, so DISPLAY is set there directly.
EnvironmentFile=/etc/stream-display/%i.xenv
Environment=PLAYWRIGHT_BROWSERS_PATH={{ stream_display_browsers_path }}
Environment=PROFILE_DIR={{ stream_display_deploy_dir }}/profiles/%i
ExecStart={{ stream_display_deploy_dir }}/venv/bin/python {{ stream_display_deploy_dir }}/stream_display.py --config /etc/stream-display/%i.yaml
TimeoutStopSec=15
KillMode=mixed
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
