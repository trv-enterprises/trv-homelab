[Unit]
Description=tsstore {{ item.name }} collector
After=network.target tsstore.service
# BindsTo: collector stops if tsstore stops or fails (strict; superset of Requires).
# PartOf: a `systemctl restart/stop tsstore` propagates to the collector, so a DB
# restart no longer silently leaves collectors dead.
BindsTo=tsstore.service
PartOf=tsstore.service

[Service]
Type=simple
User={{ tsstore_user }}
Group={{ tsstore_group }}
EnvironmentFile={{ tsstore_config_dir }}/{{ item.name }}.env
ExecStart={{ tsstore_bin_dir }}/{{ item.name }} \
    -socket {{ tsstore_socket }} \
    -store {{ item.name }}{% if item.interval is defined %} \
    -interval {{ item.interval }}{% endif %}

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
