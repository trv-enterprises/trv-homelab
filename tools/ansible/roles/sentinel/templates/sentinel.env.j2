MQTT_BROKER={{ mqtt_broker }}
HTTP_ADDR=:{{ sentinel_http_port }}
PUBLIC_BASE_URL={{ sentinel_public_base_url }}
API_TOKEN={{ sentinel_api_token }}
API_PERSON={{ sentinel_owner }}
{% if sentinel_people | default({}) | length > 0 %}
API_PEOPLE={{ sentinel_people.keys() | zip(sentinel_people.values()) | map('join', ':') | join(',') }}
{% endif %}
FRIGATE_URL={{ frigate_url }}
RETENTION={{ sentinel_retention }}
{% if apns_key_b64 is defined and apns_key_b64 | length > 0 %}
APNS_KEY_B64={{ apns_key_b64 }}
APNS_KEY_ID={{ apns_key_id }}
APNS_TEAM_ID={{ apns_team_id }}
APNS_BUNDLE_ID={{ apns_bundle_id }}
{% endif %}
{% if sentinel_dashboard_api_key is defined and sentinel_dashboard_api_key | length > 0 %}
DASHBOARD_URL={{ dashboard_url }}
DASHBOARD_API_KEY={{ sentinel_dashboard_api_key }}
DASHBOARD_PUBLIC_URL={{ dashboard_public_url }}
DASHBOARD_LINK_USER_ID={{ dashboard_link_user_id | default('') }}
DASHBOARD_MARK_SEEN={{ 'true' if (dashboard_mark_seen | default(true)) else 'false' }}
{% endif %}
