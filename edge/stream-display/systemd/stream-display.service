[Unit]
Description=stream-display: dashboard as change-driven MJPEG, MQTT-controlled
After=network-online.target stream-xvfb.service
Requires=stream-xvfb.service

[Service]
Type=simple
User=stream
WorkingDirectory=/opt/stream-display
Environment=DISPLAY=:99
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/stream-display/browsers
ExecStart=/opt/stream-display/venv/bin/python /opt/stream-display/stream_display.py --config /etc/stream-display/config.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
